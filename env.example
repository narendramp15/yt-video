# yt-video — environment variables (mirrors yt_video/settings.py)
# Copy to .env and fill in your values:  cp env.example .env
# Variable names are case-insensitive; unknown names are ignored.

# ═══════════════════════════════════════════════════════════
# REQUIRED
# ═══════════════════════════════════════════════════════════

# YouTube OAuth client — path to Google client_secret.json
# https://console.cloud.google.com/ -> Credentials -> OAuth 2.0 Client IDs -> Download JSON
YOUTUBE_CLIENT_SECRET=client_secret.json

# Your YouTube channel name (used for video tags)
CHANNEL_NAME=My Channel

# Fallback YouTube category when topic mapping finds no match
# 22 = People & Blogs | 25 = News & Politics | 28 = Science & Technology
DEFAULT_CATEGORY=22


# ═══════════════════════════════════════════════════════════
# LLM PROVIDERS
# Ordered, comma-separated. Default: Claude CLI first (subscription, notional
# cost only), OpenAI as fallback. The first usage/rate-limit signal from Claude
# trips a circuit breaker and Claude is skipped for the rest of the run.
# `main.py --claude-only` disables the fallback for one run.
# ═══════════════════════════════════════════════════════════

LLM_PROVIDERS=claude_cli,openai

# Claude CLI (needs the `claude` binary logged in via OAuth; never uses --bare)
CLAUDE_CLI_PATH=claude
CLAUDE_MODEL_SCRIPT=sonnet
CLAUDE_MODEL_LIGHT=haiku
# Per-call timeouts in seconds: script tier (long generations) / light tier
CLAUDE_TIMEOUT_SCRIPT_S=600
CLAUDE_TIMEOUT_LIGHT_S=180

# OpenAI — OPTIONAL. Only needed for the fallback LLM, OpenAI TTS/Whisper
# fallbacks, or OpenAI images. Leave unset to run on Claude only.
# OPENAI_API_KEY=sk-...
OPENAI_FALLBACK_MODEL=gpt-6-luna


# ═══════════════════════════════════════════════════════════
# TTS (Microsoft Edge TTS — free, no key)
# Indian English: en-IN-NeerjaNeural (female) | en-IN-PrabhatNeural (male)
# Run `uv run python main.py --list-voices` for all voices.
# ═══════════════════════════════════════════════════════════

EDGE_TTS_VOICE=en-IN-NeerjaNeural
EDGE_TTS_RATE=-8%
EDGE_TTS_PITCH=+1Hz


# ═══════════════════════════════════════════════════════════
# IMAGES
# Ordered chain, tried per image; first valid result wins. Providers without
# credentials are skipped. `placeholder` (offline gradient) last means image
# generation never fails.
#   pollinations | cloudflare | openai (paid) | placeholder
# ═══════════════════════════════════════════════════════════

IMAGE_PROVIDERS=pollinations,cloudflare,placeholder

# Pollinations. Free tier: 1 image / 45 s / IP, 1024x576 cap, logo watermark.
# A key removes all three limits (and the interval becomes 0).
POLLINATIONS_MODEL=flux
# POLLINATIONS_KEY=sk_...        # https://enter.pollinations.ai/
POLLINATIONS_MIN_INTERVAL_S=45

# Cloudflare Workers AI (free tier) — used when both are set
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# OpenAI images (paid) — only used when 'openai' is in IMAGE_PROVIDERS
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=low

# Local CLIP image-vs-scene verification (needs torch + transformers)
CLIP_VERIFY=true
CLIP_MIN_SCORE=0.24
CLIP_MODEL=openai/clip-vit-base-patch32


# ═══════════════════════════════════════════════════════════
# BACKGROUND MUSIC — only tracks you may use commercially
# ═══════════════════════════════════════════════════════════

BACKGROUND_MUSIC_ENABLED=true
BACKGROUND_MUSIC_DIR=assets/music
# BACKGROUND_MUSIC_TRACK=assets/music/your-track.mp3


# ═══════════════════════════════════════════════════════════
# PACKAGING / RETENTION CRAFT
# ═══════════════════════════════════════════════════════════

CHAPTER_CARDS_ENABLED=false
INTRO_CARD_ENABLED=false
LOWER_THIRDS_ENABLED=false
THUMBNAIL_TEXT_ENABLED=true
BURN_CAPTIONS_ENABLED=true
SHORTS_ENABLED=true
PACKAGING_VARIANTS=3
# Hard niche lock for topic selection, e.g. tech,ai,startups
# CHANNEL_PRIMARY_NICHE=tech,ai,startups
NICHE_LOCK_ENABLED=true
NICHE_LOCK_DAYS=30
# Pause before a public upload; approve with --approve-packaging (exit code 3)
PACKAGING_REQUIRE_APPROVAL=false


# ═══════════════════════════════════════════════════════════
# X (TWITTER) — trends and post-upload posting
# ═══════════════════════════════════════════════════════════

# TWITTER_BEARER_TOKEN=
TWITTER_WOEID=23424848
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_DAILY_POST_LIMIT=3
X_POST_PUBLIC_ONLY=true


# ═══════════════════════════════════════════════════════════
# PATHS (relative paths resolve against the repo root)
# ═══════════════════════════════════════════════════════════

# STATE_DIR=state
# RUNS_DIR=output/runs
# IMAGE_CACHE_DIR=output/cache/images
