# yt-video — environment variables
# Copy to .env and fill in your values:  cp env.example .env

# ═══════════════════════════════════════════════════════════
# REQUIRED
# ═══════════════════════════════════════════════════════════

# OpenAI API key — used for script generation (~$0.06/mo) and Whisper fallback
OPENAI_API_KEY=sk-...

# YouTube OAuth — path to Google client_secret.json (downloaded from Google Cloud Console)
# https://console.cloud.google.com/ → Credentials → OAuth 2.0 Client IDs → Download JSON
YOUTUBE_CLIENT_SECRET=client_secret.json

# Your YouTube channel name (used for video tags)
CHANNEL_NAME=My Stock Channel


# ═══════════════════════════════════════════════════════════
# OPTIONAL — Script Generation
# ═══════════════════════════════════════════════════════════

# Script model: gpt-4o-mini (default) | deepseek-chat | deepseek-reasoner
# deepseek-chat is ~6x cheaper than gpt-4o-mini (~$0.01/mo)
SCRIPT_MODEL=gpt-4o-mini

# DeepSeek API key — only needed when SCRIPT_MODEL starts with "deepseek"
# Get key at: https://platform.deepseek.com/
# DEEPSEEK_API_KEY=sk-...


# ═══════════════════════════════════════════════════════════
# OPTIONAL — FREE TTS (Microsoft Edge TTS)
# No API key needed — just configure the voice
# ═══════════════════════════════════════════════════════════

# Edge TTS voice — run `python main.py --list-voices` to see all options
# Indian English: en-IN-NeerjaNeural (female) | en-IN-PrabhatNeural (male)
# US English:     en-US-AriaNeural | en-US-JennyNeural | en-US-GuyNeural
# UK English:     en-GB-SoniaNeural | en-GB-RyanNeural
EDGE_TTS_VOICE=en-IN-NeerjaNeural
# Slightly slower + tiny pitch lift = less robotic than stock defaults
EDGE_TTS_RATE=-8%
EDGE_TTS_PITCH=+1Hz


# ═══════════════════════════════════════════════════════════
# OPTIONAL — FREE Background Music
# Add only tracks you have the right to use commercially.
# The pipeline auto-picks the first supported file in assets/music/.
# ═══════════════════════════════════════════════════════════

BACKGROUND_MUSIC_ENABLED=true
BACKGROUND_MUSIC_DIR=assets/music
# BACKGROUND_MUSIC_TRACK=assets/music/your-track.mp3


# ═══════════════════════════════════════════════════════════
# OPTIONAL — FREE Trend Signals
# All sources below require zero registration:
#   • Google Trends (pytrends) — works out of the box
#   • Financial RSS feeds      — ET Markets, Moneycontrol, LiveMint, Business Standard
#   • yfinance news            — NIFTY index + top stocks (already installed)
# No config keys needed — all three run automatically.
# ═══════════════════════════════════════════════════════════


# ═══════════════════════════════════════════════════════════
# OPTIONAL — Image Generation (pluggable provider chain)
# Ordered, comma-separated list tried per image; first valid result wins.
# PIL gradient is always the final offline fallback, so generation never fails.
#   pollinations  — FREE, no key (default)
#   openai        — PAID (gpt-image-1 / DALL-E); reuses OPENAI_API_KEY above
# NOTE: DeepSeek has no image API, so it cannot be an image provider.
# ═══════════════════════════════════════════════════════════

# Provider chain. Default is free. To use OpenAI first with a free fallback:
#   IMAGE_PROVIDERS=openai,pollinations
IMAGE_PROVIDERS=pollinations

# ── Pollinations.ai (free) ──
# Model: flux-realism (default, less AI-art) | flux | turbo
POLLINATIONS_MODEL=flux-realism
# API key — optional but recommended; removes rate limits / 530 errors
# Get your free key at: https://enter.pollinations.ai/
# POLLINATIONS_KEY=sk_...

# ── OpenAI images (paid) — only used when 'openai' is in IMAGE_PROVIDERS ──
# ~$0.01–0.02/image at low quality. Uses OPENAI_API_KEY from the REQUIRED section.
# Quality is model-specific: gpt-image-1 → low|medium|high|auto, dall-e-3 → standard|hd
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=low


# ═══════════════════════════════════════════════════════════
# OPTIONAL — YouTube
# ═══════════════════════════════════════════════════════════

# Fallback YouTube category when topic mapping finds no match
# 22 = People & Blogs · 25 = News & Politics · 28 = Science & Technology
DEFAULT_CATEGORY=22

# Retention craft — all default OFF (safer for watch time / less AI-template look)
# CHAPTER_CARDS_ENABLED=false   # full-screen "CHAPTER S1" cards between scenes
# INTRO_CARD_ENABLED=false      # 2s topic card at t=0 (fights the spoken hook)
# LOWER_THIRDS_ENABLED=false    # per-scene label bars (template look when on)

# Thumbnail packaging — ON by default (Pillow overlays 3–5 word hook text)
# THUMBNAIL_TEXT_ENABLED=true

# ── Phase B — discovery engine ──
SHORTS_ENABLED=true              # render + upload Shorts from shorts_script
BURN_CAPTIONS_ENABLED=true       # burn Whisper captions into long-form MP4
PACKAGING_VARIANTS=3             # title/hook A/B packages (heuristic pick)
# CHANNEL_PRIMARY_NICHE=tech,ai,startups   # optional niche keywords for topic re-rank


# ═══════════════════════════════════════════════════════════
# OPTIONAL — X Posting After Public Upload
# Posts only for public long videos, never shorts, with a conservative daily cap.
# ═══════════════════════════════════════════════════════════

X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_DAILY_POST_LIMIT=3
X_POST_PUBLIC_ONLY=true
